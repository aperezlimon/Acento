{
 "duration": 61.399,
 "scenes": [
  {
   "id": "s1",
   "start": 0.0,
   "end": 3.751,
   "vo_start": 0.2,
   "vo_end": 3.251,
   "phrases": [
    {
     "text": "Hubo un tiempo en que el flamenco no tenía escenario.",
     "start": 0.2,
     "end": 3.251
    }
   ]
  },
  {
   "id": "s2",
   "start": 3.751,
   "end": 9.402,
   "vo_start": 4.051,
   "vo_end": 9.002,
   "phrases": [
    {
     "text": "Se cantaba en patios y tabernas,",
     "start": 4.051,
     "end": 6.27
    },
    {
     "text": "para unos pocos,",
     "start": 6.43,
     "end": 7.604
    },
    {
     "text": "a puerta cerrada.",
     "start": 7.764,
     "end": 9.002
    }
   ]
  },
  {
   "id": "s3",
   "start": 9.402,
   "end": 17.445,
   "vo_start": 10.602,
   "vo_end": 17.045,
   "phrases": [
    {
     "text": "Hasta que llegaron los cafés cantantes: mesas, copas, un tablao…",
     "start": 10.602,
     "end": 14.527
    },
    {
     "text": "y un público que pagaba por escuchar.",
     "start": 14.847,
     "end": 17.045
    }
   ]
  },
  {
   "id": "s4",
   "start": 17.445,
   "end": 27.256,
   "vo_start": 17.745,
   "vo_end": 26.856,
   "phrases": [
    {
     "text": "El más famoso abrió en Sevilla,",
     "start": 17.745,
     "end": 19.932
    },
    {
     "text": "en la calle Rosario,",
     "start": 20.092,
     "end": 21.448
    },
    {
     "text": "en mil ochocientos ochenta y uno. Su alma:",
     "start": 21.608,
     "end": 24.338
    },
    {
     "text": "el cantaor Silverio Franconetti.",
     "start": 24.658,
     "end": 26.856
    }
   ]
  },
  {
   "id": "s5",
   "start": 27.256,
   "end": 35.827,
   "vo_start": 27.556,
   "vo_end": 34.727,
   "phrases": [
    {
     "text": "Hijo de italiano y andaluza.",
     "start": 27.556,
     "end": 29.371
    },
    {
     "text": "Lorca lo resumió así:",
     "start": 29.691,
     "end": 31.312
    },
    {
     "text": "la densa miel de Italia,",
     "start": 31.632,
     "end": 33.232
    },
    {
     "text": "con el limón nuestro.",
     "start": 33.392,
     "end": 34.727
    }
   ]
  },
  {
   "id": "s6",
   "start": 35.827,
   "end": 43.108,
   "vo_start": 36.127,
   "vo_end": 42.708,
   "phrases": [
    {
     "text": "Por su café pasaron las grandes figuras del cante.",
     "start": 36.127,
     "end": 39.306
    },
    {
     "text": "Y entre el público,",
     "start": 39.626,
     "end": 40.842
    },
    {
     "text": "un joven Antonio Chacón.",
     "start": 41.002,
     "end": 42.708
    }
   ]
  },
  {
   "id": "s7",
   "start": 43.108,
   "end": 49.187,
   "vo_start": 43.908,
   "vo_end": 48.687,
   "phrases": [
    {
     "text": "Los cafés se extendieron por Andalucía.",
     "start": 43.908,
     "end": 46.34
    },
    {
     "text": "Fue la Edad de Oro del flamenco.",
     "start": 46.66,
     "end": 48.687
    }
   ]
  },
  {
   "id": "s8",
   "start": 49.187,
   "end": 55.933,
   "vo_start": 49.487,
   "vo_end": 54.533,
   "phrases": [
    {
     "text": "Silverio murió en mil ochocientos ochenta y nueve.",
     "start": 49.487,
     "end": 52.634
    },
    {
     "text": "Su silla quedó vacía.",
     "start": 52.954,
     "end": 54.533
    }
   ]
  },
  {
   "id": "s9",
   "start": 55.933,
   "end": 61.399,
   "vo_start": 56.433,
   "vo_end": 58.599,
   "phrases": [
    {
     "text": "Pero el cante ya tenía escenario.",
     "start": 56.433,
     "end": 58.599
    }
   ]
  }
 ]
}